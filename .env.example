POSTGRES_DB=usage_dashboard
POSTGRES_USER=usage_dashboard
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://usage_dashboard:change-me@db:5432/usage_dashboard
# PostgreSQL 18+ expects the Compose volume mounted at /var/lib/postgresql.
POSTGRES_IMAGE=postgres:18-alpine

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-fernet-key
ADMIN_SESSION_EXPIRE_HOURS=24
ADMIN_RECOVERY_CODE_EXPIRE_MINUTES=30
HOMEPAGE_ALLOWED_HOSTS=

# Optional browser extension IDs used by one-click setup. These are runtime
# overrides for the prebuilt frontend image; useful when testing an unpacked/dev extension.
EXTENSION_TARGET_CHROME_ID=
EXTENSION_TARGET_EDGE_ID=
EXTENSION_TARGET_OPERA_ID=
EXTENSION_TARGET_FIREFOX_ID=
EXTENSION_TARGET_SAFARI_ID=

# Published image tag used by the default backend/frontend GHCR images.
IMAGE_TAG=latest
# Override full image references if you publish under a different registry/name.
# BACKEND_IMAGE=ghcr.io/skulldorom/usage-dashboard-backend:latest
# FRONTEND_IMAGE=ghcr.io/skulldorom/usage-dashboard-frontend:latest

# External HTTP port for the frontend/proxy container. Postgres stays internal-only.
NGINX_HTTP_PORT=3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SNAPSHOT_RETENTION_DAYS=90
AUTO_POLL_ENABLED=true
AUTO_POLL_INTERVAL_MINUTES=60
VITE_API_BASE_URL=/api

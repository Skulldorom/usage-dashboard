# Required. Use a URL-safe password because this is a URL.
DATABASE_URL=postgresql+asyncpg://usage_dashboard:replace-with-url-safe-password@127.0.0.1:5432/usage_dashboard

# Required. Generate with the command in the native Linux guide.
ENCRYPTION_KEY=replace-with-generated-fernet-key

BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1
ADMIN_SESSION_EXPIRE_HOURS=24
ADMIN_RECOVERY_CODE_EXPIRE_MINUTES=30
SNAPSHOT_RETENTION_DAYS=180
ANALYTICS_HOURLY_RETENTION_DAYS=365
AUTO_POLL_ENABLED=true
AUTO_POLL_INTERVAL_MINUTES=60
HOMEPAGE_ALLOWED_HOSTS=
CUSTOM_HTTP_ALLOWED_HOSTS=
